<div class="mb-4">
  <%= link_to admin_admin_users_path, class: "btn btn-sm btn-outline-secondary me-2" do %>
    <i class="bi bi-arrow-left"></i> Back
  <% end %>
  <h4 class="d-inline-block mb-0 fw-bold align-middle">Add Admin User</h4>
</div>

<div class="card" style="max-width:480px;">
  <div class="card-body p-4">
    <%= form_with model: @admin_user, url: admin_admin_users_path, local: true do |f| %>
      <% if @admin_user.errors.any? %>
        <div class="alert alert-danger">
          <% @admin_user.errors.full_messages.each do |msg| %>
            <div><%= msg %></div>
          <% end %>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :email, class: "form-label fw-semibold" %>
        <%= f.email_field :email, class: "form-control", autofocus: true, placeholder: "user@example.com" %>
      </div>
      <div class="mb-3">
        <%= f.label :password, class: "form-label fw-semibold" %>
        <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
      </div>
      <div class="mb-4">
        <%= f.label :password_confirmation, "Confirm Password", class: "form-label fw-semibold" %>
        <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
      </div>
      <%= f.submit "Create User", class: "btn btn-primary w-100" %>
    <% end %>
  </div>
</div>
