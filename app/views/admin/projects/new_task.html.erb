<div class="d-flex align-items-center mb-4">
  <%= link_to admin_project_path(@project), class: "btn btn-sm btn-outline-secondary me-3" do %>
    <i class="bi bi-arrow-left"></i> Back
  <% end %>
  <div>
    <h4 class="mb-0 fw-bold">Add Task</h4>
    <p class="text-muted mb-0 small"><%= @project.name %></p>
  </div>
</div>

<%= form_with url: add_task_admin_project_path(@project), method: :post do |f| %>
  <div class="card mb-4">
    <div class="card-header bg-white fw-semibold">Task Details</div>
    <div class="card-body">
      <div class="mb-0">
        <%= f.label :task_name, "Task Name", class: "form-label fw-semibold" %>
        <%= f.text_field :task_name, class: "form-control", placeholder: "e.g. Video – 8 min", required: true, autocomplete: "off" %>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-white fw-semibold">Assign Members</div>

    <% @members_by_team.each do |team_name, members| %>
      <div class="card-body border-bottom pb-3 pt-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div class="d-flex align-items-center gap-2">
            <input type="checkbox" class="form-check-input team-select-all" id="team_all_<%= team_name.parameterize %>"
                   data-team="<%= team_name.parameterize %>">
            <label class="fw-semibold small mb-0" for="team_all_<%= team_name.parameterize %>"><%= team_name %></label>
          </div>
          <span class="badge bg-light text-secondary border"><%= members.size %></span>
        </div>
        <div class="row g-1 ms-3">
          <% members.each do |member| %>
            <div class="col-md-4 col-lg-3">
              <div class="form-check">
                <%= check_box_tag "assignee_ids[]", member[:hubstaff_user_id],
                      false,
                      class: "form-check-input member-checkbox team-member-#{team_name.parameterize}",
                      id: "member_#{member[:hubstaff_user_id]}" %>
                <label class="form-check-label small" for="member_<%= member[:hubstaff_user_id] %>">
                  <%= member[:name] %>
                </label>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Add Task", class: "btn btn-success" %>
    <%= link_to "Cancel", admin_project_path(@project), class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<script>
  document.querySelectorAll('.team-select-all').forEach(function (teamCb) {
    teamCb.addEventListener('change', function () {
      var teamClass = '.team-member-' + this.dataset.team;
      document.querySelectorAll(teamClass).forEach(function (cb) {
        cb.checked = teamCb.checked;
      });
    });
  });

  // Keep team checkbox in sync when individual members change
  document.querySelectorAll('.member-checkbox').forEach(function (cb) {
    cb.addEventListener('change', function () {
      var teamClass = this.classList[2]; // team-member-{team}
      var team = teamClass.replace('team-member-', '');
      var all  = document.querySelectorAll('.' + teamClass);
      var checked = Array.from(all).filter(function (c) { return c.checked; }).length;
      var teamCb  = document.getElementById('team_all_' + team);
      if (teamCb) {
        teamCb.checked       = checked === all.length;
        teamCb.indeterminate = checked > 0 && checked < all.length;
      }
    });
  });
</script>
