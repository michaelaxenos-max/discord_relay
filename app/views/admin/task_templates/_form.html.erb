<div class="mb-3">
  <%= f.label :name, "Task Name", class: "form-label fw-semibold" %>
  <%= f.text_field :name, class: "form-control #{'is-invalid' if task_template.errors[:name].any?}" %>
  <% if task_template.errors[:name].any? %>
    <div class="invalid-feedback"><%= task_template.errors[:name].join(", ") %></div>
  <% end %>
</div>

<div class="mb-4 form-check">
  <%= f.check_box :dynamic, class: "form-check-input" %>
  <%= f.label :dynamic, "Dynamic task", class: "form-check-label" %>
  <div class="form-text">Dynamic tasks have a custom client name appended at project creation time.</div>
</div>
