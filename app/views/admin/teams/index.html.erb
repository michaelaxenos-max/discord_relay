<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h4 class="mb-0 fw-bold">Teams &amp; Tasks</h4>
    <p class="text-muted mb-0 small">Task templates are synced from Hubstaff teams</p>
  </div>
  <%= button_to resync_admin_teams_path, method: :post, class: "btn btn-outline-primary" do %>
    <i class="bi bi-arrow-repeat me-1"></i> Resync Teams from Hubstaff
  <% end %>
</div>

<% if @teams.empty? %>
  <div class="card">
    <div class="card-body text-center py-5 text-muted">
      <i class="bi bi-diagram-3" style="font-size:2rem;"></i>
      <p class="mt-2 mb-0">No teams yet. Click "Resync Teams from Hubstaff" to import them.</p>
    </div>
  </div>
<% else %>
  <% @teams.each do |team| %>
    <div class="card mb-4">
      <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <span class="fw-semibold fs-6">
          <i class="bi bi-people-fill text-primary me-2"></i><%= team.name %>
        </span>
        <span class="badge bg-secondary rounded-pill"><%= team.task_templates.size %> tasks</span>
      </div>

      <div class="card-body p-0">
        <% if team.task_templates.any? %>
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Task Name</th>
                <th>Type</th>
                <th class="text-end pe-3">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% team.task_templates.order(:name).each do |task| %>
                <tr>
                  <td class="ps-3"><%= task.name %></td>
                  <td>
                    <% if task.dynamic? %>
                      <span class="badge bg-warning text-dark">Dynamic</span>
                    <% else %>
                      <span class="badge bg-light text-secondary border">Fixed</span>
                    <% end %>
                  </td>
                  <td class="text-end pe-3">
                    <%= link_to edit_admin_task_template_path(task), class: "btn btn-sm btn-outline-secondary me-1" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= button_to admin_task_template_path(task), method: :delete,
                          class: "btn btn-sm btn-outline-danger",
                          form: { data: { turbo_confirm: "Delete task \"#{task.name}\"?" } } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-muted small p-3 mb-0">No tasks yet.</p>
        <% end %>

        <!-- Add task inline form -->
        <div class="border-top p-3 bg-light">
          <%= form_with model: [:admin, team, TaskTemplate.new], url: admin_team_task_templates_path(team) do |f| %>
            <div class="row g-2 align-items-end">
              <div class="col">
                <%= f.text_field :name, class: "form-control form-control-sm", placeholder: "New task name" %>
              </div>
              <div class="col-auto">
                <div class="form-check form-check-inline mb-0">
                  <%= f.check_box :dynamic, class: "form-check-input", id: "dynamic_#{team.id}" %>
                  <label class="form-check-label small" for="dynamic_<%= team.id %>">Dynamic</label>
                </div>
              </div>
              <div class="col-auto">
                <%= f.submit "Add Task", class: "btn btn-sm btn-success" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
