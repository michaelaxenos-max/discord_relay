<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
      body { background-color: #f8f9fa; }
      .sidebar {
        min-height: 100vh;
        background: #1e2a3a;
        padding-top: 1rem;
      }
      .sidebar .nav-link {
        color: #adb5bd;
        padding: 0.6rem 1.2rem;
        border-radius: 0.375rem;
        margin: 0.1rem 0.5rem;
        transition: background 0.15s;
      }
      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background: rgba(255,255,255,0.1);
        color: #fff;
      }
      .sidebar .nav-link i { margin-right: 0.5rem; }
      .sidebar-brand {
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
        padding: 0.5rem 1.2rem 1rem;
        display: block;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 0.75rem;
      }
      .sidebar-brand:hover { color: #e9ecef; }
      .main-content { padding: 2rem; }
      .navbar-top {
        background: #fff;
        border-bottom: 1px solid #dee2e6;
        padding: 0.75rem 1.5rem;
      }
      .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
      .table th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #6c757d; }
    </style>
  </head>
  <body>
    <div class="container-fluid p-0">
      <div class="row g-0">
        <!-- Sidebar -->
        <div class="col-auto d-flex flex-column sidebar" style="width:220px; min-width:220px;">
          <a href="<%= admin_root_path %>" class="sidebar-brand">
            <i class="bi bi-shield-lock-fill"></i> Admin Panel
          </a>
          <nav class="nav flex-column">
            <a href="<%= admin_root_path %>"
               class="nav-link <%= 'active' if controller_name == 'dashboard' %>">
              <i class="bi bi-people-fill"></i> Users
            </a>
            <a href="<%= admin_teams_path %>"
               class="nav-link <%= 'active' if %w[teams task_templates].include?(controller_name) %>">
              <i class="bi bi-diagram-3-fill"></i> Teams &amp; Tasks
            </a>
            <a href="<%= admin_projects_path %>"
               class="nav-link <%= 'active' if controller_name == 'projects' %>">
              <i class="bi bi-folder2-open"></i> Projects
            </a>
            <a href="<%= new_admin_project_resync_path %>"
               class="nav-link <%= 'active' if controller_name == 'project_resync' %>">
              <i class="bi bi-list-check"></i> Resync Tasks
            </a>
            <a href="/admin/jobs" class="nav-link">
              <i class="bi bi-cpu"></i> Job Queues
            </a>
          </nav>
          <% if admin_user_signed_in? %>
            <div class="mt-auto px-3 pb-3">
              <small class="text-secondary d-block mb-2 text-truncate"><%= current_admin_user.email %></small>
              <%= button_to "Log out", destroy_admin_user_session_path,
                    method: :delete,
                    class: "btn btn-sm btn-outline-secondary w-100" %>
            </div>
          <% end %>
        </div>

        <!-- Main area -->
        <div class="col d-flex flex-column" style="min-height:100vh;">
          <% if flash[:notice] || flash[:alert] %>
            <div class="px-4 pt-3">
              <% if flash[:notice] %>
                <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
                  <%= flash[:notice] %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              <% end %>
              <% if flash[:alert] %>
                <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
                  <%= flash[:alert] %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              <% end %>
            </div>
          <% end %>

          <main class="main-content flex-grow-1">
            <%= yield %>
          </main>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmRmQfM8s+ixBLO6a5UzK7MnJed"
            crossorigin="anonymous"></script>
    <script>
      document.querySelectorAll('time[data-utc]').forEach(function(el) {
        var d = new Date(el.dataset.utc);
        if (isNaN(d)) return;
        el.textContent = new Intl.DateTimeFormat(undefined, {
          month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit',
          hour12: false
        }).format(d);
        el.title = d.toISOString() + ' UTC';
      });
    </script>
  </body>
</html>
